<Page x:Class="ModelEditPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <Page.Resources>
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="6,3">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TxtTitle"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Foreground="White"
                   Margin="0,0,0,12"
                   Text="模板修刪查"/>

        <!--搜尋列-->
        <Grid Grid.Row="1"
              Margin="0,0,0,15">

            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="200"/>
            </Grid.ColumnDefinitions>

            <ui:TextBox
                x:Name="TbSearch"
                PlaceholderText="搜尋模板..."
                TextChanged="TbSearch_TextChanged"/>

            <ComboBox
                x:Name="CbSort"
                Grid.Column="1"
                Margin="10,0,0,0"
                SelectionChanged="CbSort_SelectionChanged">

                <ComboBoxItem IsSelected="True">
                    字母(A-Z)
                </ComboBoxItem>

                <ComboBoxItem>
                    注音
                </ComboBoxItem>

            </ComboBox>

            <Button Grid.Column="2"
                    x:Name="BtnRefresh"
                    Margin="10,0,0,0"
                    Content="重新整理"
                    Click="BtnRefresh_Click"/>

            <TextBlock Grid.Column="3"
                       x:Name="TxtSortIndicator"
                       Margin="12,0,0,0"
                       VerticalAlignment="Center"
                       Foreground="#CBA0FF"
                       FontWeight="SemiBold"
                       Text="目前排序：字母(A-Z)"/>

        </Grid>

        <!--模板 + 右側索引-->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="52"/>
            </Grid.ColumnDefinitions>

            <ListView x:Name="LvTemplate"
                      Grid.Column="0">

                <ListView.ItemTemplate>

                    <DataTemplate>

                        <Border
                            Margin="0,5"
                            Padding="12"
                            Height="156"
                            CornerRadius="8"
                            Background="#181A24">

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock
                                    Grid.Row="0"
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Foreground="White"
                                    Text="{Binding Name}"
                                    TextTrimming="CharacterEllipsis"/>

                                <TextBlock Grid.Row="1"
                                           Margin="0,4,0,0"
                                           Foreground="Gray"
                                           Text="{Binding CameraSummary}"
                                           TextTrimming="CharacterEllipsis"/>

                                <TextBlock Grid.Row="2"
                                           Margin="0,2,0,0"
                                           Foreground="Gray"
                                           Text="{Binding LastUpdated}"
                                           TextTrimming="CharacterEllipsis"/>

                                <TextBlock Grid.Row="3"
                                           Margin="0,2,0,8"
                                           Foreground="DarkGray"
                                           FontSize="11"
                                           Text="{Binding FullPath}"
                                           TextTrimming="CharacterEllipsis"/>

                                <StackPanel Grid.Row="4"
                                            Orientation="Horizontal">
                                    <Button Width="70"
                                            Style="{StaticResource ActionButtonStyle}"
                                            Background="#8E24AA"
                                            Margin="0,0,8,0"
                                            Content="{Binding TrainText}"
                                            Tag="{Binding FullPath}"
                                            Click="BtnTrain_Click"/>
                                    <Button Width="70"
                                            Style="{StaticResource ActionButtonStyle}"
                                            Background="#7E57C2"
                                            Margin="0,0,8,0"
                                            Content="{Binding ReviseText}"
                                            Tag="{Binding FullPath}"
                                            Click="BtnRevise_Click"/>
                                    <Button Width="70"
                                            Style="{StaticResource ActionButtonStyle}"
                                            Background="#5E35B1"
                                            Margin="0,0,8,0"
                                            Content="{Binding DeleteText}"
                                            Tag="{Binding FullPath}"
                                            Click="BtnDelete_Click"/>
                                    <Button Width="90"
                                            Style="{StaticResource ActionButtonStyle}"
                                            Background="#512DA8"
                                            Content="{Binding OpenFolderText}"
                                            Tag="{Binding FullPath}"
                                            Click="BtnOpenFolder_Click"/>
                                </StackPanel>
                            </Grid>

                        </Border>

                    </DataTemplate>

                </ListView.ItemTemplate>

            </ListView>

            <Border Grid.Column="1"
                    Margin="8,0,0,0"
                    CornerRadius="10"
                    Background="#141722"
                    Padding="4">
                <ListBox x:Name="LvSortIndex"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="#CBA0FF"
                         FontSize="11"
                         SelectionChanged="LvSortIndex_SelectionChanged"/>
            </Border>
        </Grid>

    </Grid>

</Page>