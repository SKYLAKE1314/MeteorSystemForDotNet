<Page x:Class="HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
      Background="#1E1E1E"
      Loaded="Page_Loaded">

    <Grid Margin="10">

        <Grid.RowDefinitions>

            <!-- Toolbar -->
            <RowDefinition Height="60"/>

            <!-- Main -->
            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>

        <!-- ========================= -->
        <!-- Toolbar -->
        <!-- ========================= -->
        <Border Grid.Row="0"
        Background="#252526"
        BorderBrush="#3C3C3C"
        BorderThickness="1"
        CornerRadius="6"
        Padding="8"
        Margin="0,0,0,0">

            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Disabled"
                  PanningMode="HorizontalOnly">

                <StackPanel Orientation="Horizontal">

                    <TextBlock Text="相機選擇:"
                    Foreground="White"
                    VerticalAlignment="Center"
                    Margin="0,0,5,0"/>

                    <ComboBox x:Name="CameraComboBox"
                    Width="200"
                    Height="32"
                    Margin="0,0,10,0"
                    VerticalAlignment="Center"
                    DisplayMemberPath="DisplayName"
                    SelectedValuePath="DeviceId"
                    SelectionChanged="CameraComboBox_SelectionChanged"/>

                    <Button x:Name="BtnLoadImage"
                    Content="選擇圖像"
                    Width="120"
                    Height="32"
                    Margin="0,0,10,0"
                    Click="BtnLoadImage_Click"/>

                    <Button x:Name="BtnClear"
                    Content="清空"
                    Width="100"
                    Height="32"
                    Margin="0,0,10,0"
                    Click="BtnClear_Click"/>

                    <Button x:Name="BtnStart"
                    Content="開始"
                    Width="100"
                    Height="32"
                    Margin="0,0,10,0"
                    Click="BtnStart_Click"/>

                    <Button x:Name="BtnStop"
                    Content="停止"
                    Width="100"
                    Height="32"
                    Margin="0,0,10,0"
                    Click="BtnStop_Click"/>

                    <Button x:Name="BtnGetImg"
                    Content="即時檢測"
                    Width="100"
                    Height="32"
                    Margin="0,0,10,0"/>

                    <Button x:Name="BtnSave"
                    Content="圖像儲存"
                    Width="100"
                    Height="32"
                    Margin="0,0,10,0"
                    Click="BtnSave_Click"/>

                    <Button x:Name="BtnLaplacian"
                    Content="Laplacian運算"
                    Width="120"
                    Height="32"
                    Margin="0,0,10,0"
                    Click="BtnLaplacian_Click"/>

                    <Button x:Name="BtnOcrTest"
                    Content="OCR測試"
                    Width="120"
                    Height="32"
                    Margin="0,0,10,0"
                    Click="BtnOcrTest_Click"/>

                </StackPanel>

            </ScrollViewer>

        </Border>

        <!-- ========================= -->
        <!-- Main -->
        <!-- ========================= -->
        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>

                <!-- 左 -->
                <ColumnDefinition Width="2*" />

                <!-- 右 -->
                <ColumnDefinition Width="3*" />

            </Grid.ColumnDefinitions>

            <!-- ========================= -->
            <!-- Log -->
            <!-- ========================= -->
            <Border Grid.Column="0"
        Background="#252526"
        BorderBrush="#3C3C3C"
        BorderThickness="1"
        CornerRadius="8" 
        Padding="12"
        Margin="0,0,10,0">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" LastChildFill="False">
                        <TextBlock Text="運行日誌"
                       Foreground="#E0E0E0"
                       FontSize="14"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"/>
                    </DockPanel>

                    <Border Grid.Row="2"
                Background="#1B1B1B"
                BorderBrush="#3C3C3C"
                BorderThickness="1"
                CornerRadius="4"
                Padding="8">

                        <RichTextBox x:Name="rtbLog"
                         IsReadOnly="True"
                         FontFamily="Consolas"
                         FontSize="12"
                         Background="Transparent"
                         Foreground="#A0A0A0"
                         BorderThickness="0"
                         VerticalScrollBarVisibility="Auto">
                            <RichTextBox.Resources>
                                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#7C5CDB"/>
                            </RichTextBox.Resources>
                        </RichTextBox>
                    </Border>
                </Grid>
            </Border>

            <!-- ========================= -->
            <!-- Render -->
            <!-- ========================= -->
            <Border Grid.Column="1"
                    Background="#252526"
                    BorderBrush="#3C3C3C"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="6">

                <Grid>

                    <Grid.RowDefinitions>

                        <RowDefinition Height="40"/>
                        <RowDefinition Height="*"/>

                    </Grid.RowDefinitions>

                    <!-- Title -->
                    <TextBlock Text="運行結果"
                               Foreground="White"
                               FontSize="16"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>

                    <!-- Image -->
                    <Border Grid.Row="1"
                            Background="#1E1E1E"
                            BorderBrush="#3C3C3C"
                            BorderThickness="1"
                            CornerRadius="4">

                        <Viewbox Stretch="Uniform">

                            <Image x:Name="RenderImage"
                                   Stretch="Uniform"/>

                        </Viewbox>

                    </Border>

                </Grid>

            </Border>

        </Grid>

        <!-- Win11-style loading overlay -->
        <Grid x:Name="HomeLoadingOverlay"
              Grid.RowSpan="2"
              Visibility="Collapsed"
              Background="#CC0D0D1A"
              Panel.ZIndex="99">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ui:ProgressRing IsIndeterminate="True" Width="48" Height="48"
                                 Foreground="#7C5CDB"/>
                <TextBlock x:Name="HomeLoadingText"
                           Text="初始化"
                           Foreground="#E0E0FF"
                           FontSize="13"
                           HorizontalAlignment="Center"
                           Margin="0,14,0,0"/>
            </StackPanel>
        </Grid>

    </Grid>

</Page>