<Window x:Class="TemplateManageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="管理模板"
        Width="600"
        Height="500"
        WindowStartupLocation="CenterOwner"
        Background="#11131A">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="訓練模板列表" Foreground="White" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>

        <DataGrid Grid.Row="1"
                  x:Name="TemplateGrid"
                  Background="#1A1E29"
                  Foreground="White"
                  GridLinesVisibility="Horizontal"
                  BorderBrush="#2A2E38"
                  BorderThickness="1"
                  CanUserAddRows="False"
                  AutoGenerateColumns="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="80" IsReadOnly="True"/>
                <DataGridTextColumn Header="相機" Binding="{Binding CameraSlot}" Width="60" IsReadOnly="True"/>
                <DataGridTextColumn Header="建立時間" Binding="{Binding CreatedAtDisplay}" Width="140" IsReadOnly="True"/>
                <DataGridTextColumn Header="最後使用" Binding="{Binding LastUsedDisplay}" Width="140" IsReadOnly="True"/>
                <DataGridTemplateColumn Header="操作" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="刪除" Padding="8,4" FontSize="11" Margin="0"
                                        Background="#D32F2F" Foreground="White"
                                        Click="BtnDelete_Click" Tag="{Binding Id}"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="確定" Width="80" Height="32" Margin="0,0,8,0"
                    Background="#4CAF50" Foreground="White"
                    Click="BtnOk_Click"/>
            <Button Content="取消" Width="80" Height="32"
                    Background="#455A64" Foreground="White"
                    Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
