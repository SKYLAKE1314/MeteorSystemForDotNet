<Page x:Class="ProcessPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="650"
      d:DesignWidth="1100">

    <Grid Margin="15">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <GroupBox Header="WebSocket Server"
          Foreground="White"
          Grid.Row="0"
          Margin="0,0,0,10">

            <Grid Margin="10">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- IP -->
                <TextBlock Text="IP:"
                   VerticalAlignment="Center"/>

                <!-- PORT -->
                <TextBlock Grid.Column="2"
                   Text="Port:"
                   VerticalAlignment="Center"/>

                <TextBox x:Name="PortBox"
                 Grid.Column="3"
                 Text="5000"
                 Margin="5,0,15,0"/>

                <Button x:Name="BtnStartServer"
                Grid.Column="4"
                Content="Start"
                Width="100"
                Margin="0,0,5,0"
                Click="StartServer_Click"/>

                <Button x:Name="BtnStopServer"
                Grid.Column="5"
                Content="Stop"
                Width="100"
                Click="StopServer_Click"/>

                <!-- Options row -->
                <StackPanel Grid.Row="1"
                    Grid.ColumnSpan="6"
                    Orientation="Horizontal"
                    Margin="0,8,0,0">

                    <CheckBox x:Name="DataReturn"
          Content="數據返回"
          Checked="DataReturn_Checked"
          Unchecked="DataReturn_Unchecked"/>

                    <CheckBox x:Name="Realtime"
          Content="即時結果"
          Checked="Realtime_Checked"
          Unchecked="Realtime_Unchecked"/>
                </StackPanel>

            </Grid>
        </GroupBox>
        <!-- ================= CLIENT ================= -->
        <GroupBox Header="WebSocket Client"
                  Grid.Row="1"
                  Margin="0,0,0,10"
                  Foreground="White">

            <Grid Margin="10">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="URL:"
                           VerticalAlignment="Center"/>

                <TextBox x:Name="UrlBox"
                         Grid.Column="1"
                         Text="ws://127.0.0.1:5000/ws"
                         Margin="10,0,10,0"/>

                <Button x:Name="BtnConnect"
                        Grid.Column="2"
                        Content="Connect"
                        Width="100"
                        Margin="0,0,5,0"
                        Click="Connect_Click"/>

                <Button x:Name="BtnDisconnect"
                        Grid.Column="3"
                        Content="Disconnect"
                        Width="100"
                        Click="Disconnect_Click"/>

            </Grid>

        </GroupBox>

        <!-- ================= MESSAGE ================= -->
        <GroupBox Header="Message Sender"
                  Grid.Row="2"
                  Foreground="White"
                  Margin="0,0,0,10">

            <Grid Margin="10">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="SendBox"
                         Height="32"
                         VerticalContentAlignment="Center"/>

                <Button x:Name="BtnSend"
                        Grid.Column="1"
                        Content="Send"
                        Width="120"
                        Margin="10,0,0,0"
                        Click="Send_Click"/>

                <Button x:Name="BtnBroadcast"
                        Grid.Column="2"
                        Content="Broadcast"
                        Width="120"
                        Margin="10,0,0,0"
                        Click="Broadcast_Click"/>

            </Grid>

        </GroupBox>

        <!-- ================= LOG ================= -->
        <GroupBox Header="Log Console Area"
                  Foreground="White"
                  Grid.Row="3">

            <DockPanel>

                <StackPanel Orientation="Horizontal"
                            DockPanel.Dock="Top"
                            HorizontalAlignment="Right">

                    <Button Content="Clear"
                            Width="80"
                            Margin="5"
                            Click="ClearLog_Click"/>

                </StackPanel>

                <ListBox x:Name="LogBox"
                         Margin="5"
                         FontFamily="Consolas"/>

            </DockPanel>

        </GroupBox>

    </Grid>

</Page>