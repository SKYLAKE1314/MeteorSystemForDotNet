<Page x:Class="SettingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <Grid>
        <StackPanel
            Margin="32"
            VerticalAlignment="Top"
            HorizontalAlignment="Left">

            <!-- 標題 -->
            <TextBlock
                Text="語言"
                FontSize="16"
                FontWeight="SemiBold"
                Foreground="White"
                Margin="0,0,0,0"/>
            <ComboBox x:Name="LanguageComboBox"
                  Width="200"
                  Margin="20"
                  SelectionChanged="LanguageComboBox_SelectionChanged">

                <ComboBoxItem Content="正體中文"/>
                <ComboBoxItem Content="简体中文"/>
                <ComboBoxItem Content="English"/>

            </ComboBox>

            <TextBlock
                Text="IO板卡"
                FontSize="16"
                FontWeight="SemiBold"
                Foreground="White"
                Margin="0,0,0,0"/>
            <ComboBox x:Name="IoBoardComboBox"
                  Width="200"
                  Margin="20"
                  SelectionChanged="IoBoardComboBox_SelectionChanged">

                <ComboBoxItem Content="IO"/>
                <ComboBoxItem Content="PLC"/>
                <ComboBoxItem Content="NONE"/>

            </ComboBox>

            <!-- Camera -->
            <TextBlock Text="相機"
               FontSize="16"
               FontWeight="SemiBold"
               Foreground="White"
               Margin="0,0,0,8"/>

            <ItemsControl ItemsSource="{Binding CameraRows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="0,4">

                            <!-- 標題 -->
                            <TextBlock Text="{Binding Title}"
                               Width="60"
                               Foreground="White"
                               VerticalAlignment="Center"/>

                            <!-- 相機選擇 -->
                            <ComboBox Width="200"
                              ItemsSource="{Binding CameraList}"
                              DisplayMemberPath="Name"
                              SelectedItem="{Binding SelectedCamera}"
                              SelectionChanged="Camera_SelectionChanged"/>

                            <!-- + 按鈕（只最後一列顯示） -->
                            <Button Content="+"
                            Width="40"
                            Margin="10,0,0,0"
                            Click="AddCamera_Click"
                            Visibility="{Binding AddVisible}"/>

                            <!-- - 按鈕（第二列開始才顯示） -->
                            <Button Content="-"
                            Width="40"
                            Margin="10,0,0,0"
                            Click="RemoveCamera_Click"
                            Visibility="{Binding RemoveVisible}"/>

                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock
                Text="自動化執行"
                FontSize="16"
                FontWeight="SemiBold"
                Foreground="White"
                Margin="0,20,0,0"/>

            <ComboBox x:Name="AutoRun"
       Width="200"
       SelectionChanged="AutoRunComboBox_SelectionChanged">

                <ComboBoxItem Content="True"/>
                <ComboBoxItem Content="False"/>
            </ComboBox>

            <!-- DLBoost -->
            <TextBlock
                Text="GPU硬件加速計劃"
                FontSize="16"
                FontWeight="SemiBold"
                Foreground="White"
                Margin="0,20,0,0"/>

            <ComboBox x:Name="GpuBoostComboBox"
       Width="200"
       SelectionChanged="GpuBoostComboBox_SelectionChanged">

                <ComboBoxItem Content="CPU"/>
                <ComboBoxItem Content="CUDA"/>
                <ComboBoxItem Content="OpenVino"/>
                <ComboBoxItem Content="DML"/>
            </ComboBox>
        </StackPanel>
        
        
    </Grid>

</Page>