<Page x:Class="SettingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel
            Margin="32"
            VerticalAlignment="Top"
            HorizontalAlignment="Left">

            <!-- 標題 -->
            <TextBlock
                x:Name="TxtLanguageTitle"
                Text="語言"
                FontSize="16"
                FontWeight="SemiBold"
                Foreground="White"
                Margin="0,0,0,0"/>
            <ComboBox x:Name="LanguageComboBox"
                  Width="200"
                  Margin="20"
                  SelectionChanged="LanguageComboBox_SelectionChanged">

                <ComboBoxItem Content="正體中文"/>
                <ComboBoxItem Content="简体中文"/>
                <ComboBoxItem Content="English"/>
                <ComboBoxItem Content="日本語"/>

            </ComboBox>

            <TextBlock
                x:Name="TxtIoBoardTitle"
                Text="IO板卡"
                FontSize="16"
                FontWeight="SemiBold"
                Foreground="White"
                Margin="0,0,0,0"/>
            <ComboBox x:Name="IoBoardComboBox"
                  Width="200"
                  Margin="20"
                  SelectionChanged="IoBoardComboBox_SelectionChanged">

                <ComboBoxItem Content="IO"/>
                <ComboBoxItem Content="PLC"/>
                <ComboBoxItem Content="NONE"/>

            </ComboBox>

            <!-- Camera -->
            <TextBlock x:Name="TxtCameraTitle"
                Text="相機"
               FontSize="16"
               FontWeight="SemiBold"
               Foreground="White"
               Margin="0,0,0,8"/>

            <ItemsControl ItemsSource="{Binding CameraRows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="0,4">

                            <!-- 標題 -->
                            <TextBlock Text="{Binding Title}"
                               Width="60"
                               Foreground="White"
                               VerticalAlignment="Center"/>

                            <!-- 相機選擇 -->
                            <ComboBox Width="250"
                              ItemsSource="{Binding CameraList}"
                              DisplayMemberPath="DisplayName"
                              SelectedItem="{Binding SelectedCamera}"
                              SelectionChanged="Camera_SelectionChanged"/>

                            <!-- 分辨率選擇 -->
                            <ComboBox Width="130"
                              Margin="8,0,0,0"
                              ItemsSource="{Binding ResolutionList}"
                              DisplayMemberPath="DisplayName"
                              SelectedItem="{Binding SelectedResolution}"
                              SelectionChanged="Resolution_SelectionChanged"/>

                            <!-- + 按鈕（只最後一列顯示） -->
                            <Button Content="+"
                            Width="40"
                            Margin="10,0,0,0"
                            Click="AddCamera_Click"
                            Visibility="{Binding AddVisible}"/>

                            <!-- - 按鈕（第二列開始才顯示） -->
                            <Button Content="-"
                            Width="40"
                            Margin="10,0,0,0"
                            Click="RemoveCamera_Click"
                            Visibility="{Binding RemoveVisible}"/>

                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 錄影相機 -->
            <TextBlock x:Name="TxtRecordingCameraTitle"
                Text="錄影相機"
                FontSize="16"
                FontWeight="SemiBold"
                Foreground="White"
                Margin="0,12,0,8"/>
            <ComboBox x:Name="RecordingCameraComboBox"
                  Width="250"
                  Margin="20,0,0,0"
                  ItemsSource="{Binding RecordingCameraList}"
                  DisplayMemberPath="DisplayName"
                  SelectionChanged="RecordingCameraComboBox_SelectionChanged"/>

            <!-- OCR 方式 -->
            <TextBlock x:Name="TxtOcrModeTitle"
                Text="OCR方式"
                FontSize="16"
                FontWeight="SemiBold"
                Foreground="White"
                Margin="0,20,0,8"/>
            <ComboBox x:Name="OcrModeComboBox"
                  Width="200"
                  Margin="20,0,0,0"
                  SelectionChanged="OcrModeComboBox_SelectionChanged">
                <ComboBoxItem Content="標準 (PaddleOCR)"/>
                <ComboBoxItem Content="AI (Ollama gml-ocr)"/>
            </ComboBox>

            <!-- 解碼方式 -->
            <TextBlock x:Name="TxtDecodeModeTitle"
                Text="解碼方式"
                FontSize="16"
                FontWeight="SemiBold"
                Foreground="White"
                Margin="0,20,0,8"/>
            <ComboBox x:Name="DecodeModeComboBox"
                  Width="200"
                  Margin="20,0,0,0"
                  SelectionChanged="DecodeModeComboBox_SelectionChanged">
                <ComboBoxItem Content="標準 (ZXing)"/>
                <ComboBoxItem Content="深度學習 (WeChat QR)"/>
            </ComboBox>

            <TextBlock
                x:Name="TxtAutoRunTitle"
                Text="自動化執行"
                FontSize="16"
                FontWeight="SemiBold"
                Foreground="White"
                Margin="0,20,0,0"/>

            <ComboBox x:Name="AutoRun"
       Width="200"
       SelectionChanged="AutoRunComboBox_SelectionChanged">

                <ComboBoxItem Content="True"/>
                <ComboBoxItem Content="False"/>
            </ComboBox>

            <!-- DLBoost -->
            <TextBlock
                x:Name="TxtGpuTitle"
                Text="GPU硬件加速計劃"
                FontSize="16"
                FontWeight="SemiBold"
                Foreground="White"
                Margin="0,20,0,0"/>

            <ComboBox x:Name="GpuBoostComboBox"
       Width="200"
       SelectionChanged="GpuBoostComboBox_SelectionChanged">

                <ComboBoxItem Content="CPU"/>
                <ComboBoxItem Content="CUDA"/>
                <ComboBoxItem Content="OpenVino"/>
                <ComboBoxItem Content="DML"/>
            </ComboBox>

            <!-- 開機自啟 -->
            <TextBlock
                x:Name="TxtAutoStartupTitle"
                Text="開機自啟"
                FontSize="16"
                FontWeight="SemiBold"
                Foreground="White"
                Margin="0,20,0,0"/>
            <ComboBox x:Name="AutoStartupComboBox"
                  Width="200"
                  Margin="20,4,0,0"
                  SelectionChanged="AutoStartupComboBox_SelectionChanged">
                <ComboBoxItem Content="True"/>
                <ComboBoxItem Content="False"/>
            </ComboBox>

            <!-- 靜默啟動 -->
            <TextBlock
                x:Name="TxtSilentStartTitle"
                Text="靜默啟動（最小化至托盤）"
                FontSize="16"
                FontWeight="SemiBold"
                Foreground="White"
                Margin="0,20,0,0"/>
            <ComboBox x:Name="SilentStartComboBox"
                  Width="200"
                  Margin="20,4,0,0"
                  SelectionChanged="SilentStartComboBox_SelectionChanged">
                <ComboBoxItem Content="True"/>
                <ComboBoxItem Content="False"/>
            </ComboBox>
        </StackPanel>
        </ScrollViewer>

        <!-- Win11-style loading overlay -->
        <Grid x:Name="LoadingOverlay"
              Visibility="Collapsed"
              Background="#CC0D0D1A">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ui:ProgressRing IsIndeterminate="True" Width="48" Height="48"
                                 Foreground="#7C5CDB"/>
                <TextBlock x:Name="LoadingText"
                           Text="載入中..."
                           Foreground="#E0E0FF"
                           FontSize="13"
                           HorizontalAlignment="Center"
                           Margin="0,14,0,0"/>
            </StackPanel>
        </Grid>

    </Grid>
</Page>