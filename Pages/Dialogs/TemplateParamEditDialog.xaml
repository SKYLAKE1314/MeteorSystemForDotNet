<Window x:Class="TemplateParamEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="編輯模板參數"
        Width="520"
        Height="560"
        Background="#1E1E2E"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 標題 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock x:Name="TxtTitle"
                       Text="模板參數編輯"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="White"/>
            <TextBlock x:Name="TxtTemplateName"
                       FontSize="13"
                       Foreground="#9399B2"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <!-- 參數表單 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- 匹配閾值 -->
                <TextBlock Text="匹配閾值 (0.01 ~ 1.00)" Foreground="#CDD6F4" Margin="0,0,0,4"/>
                <ui:TextBox x:Name="TxtThreshold" PlaceholderText="例如: 0.85" Margin="0,0,0,16"/>

                <TextBlock Text="大小容許範圍 (0 ~ 0.5，例如 0.1 表示 ±10% 縮放)" Foreground="#CDD6F4" Margin="0,0,0,4"/>
                <ui:TextBox x:Name="TxtScaleTolerance" PlaceholderText="例如: 0.1" Margin="0,0,0,16"/>

                <Separator Background="#313244" Margin="0,4,0,16"/>

                <!-- 解碼 -->
                <TextBlock Text="條碼解碼" FontWeight="SemiBold" Foreground="#CBA6F7" FontSize="14" Margin="0,0,0,8"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="啟用解碼" Foreground="#CDD6F4" Width="120" VerticalAlignment="Center"/>
                    <CheckBox x:Name="ChkEnableBarcode" Foreground="White"/>
                </StackPanel>

                <TextBlock Text="解碼期望結果（留空表示不驗證）" Foreground="#CDD6F4" Margin="0,0,0,4"/>
                <ui:TextBox x:Name="TxtBarcodeExpected" PlaceholderText="例如: ABC123" Margin="0,0,0,16"/>

                <Separator Background="#313244" Margin="0,4,0,16"/>

                <!-- OCR -->
                <TextBlock Text="OCR 文字辨識" FontWeight="SemiBold" Foreground="#CBA6F7" FontSize="14" Margin="0,0,0,8"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="啟用 OCR" Foreground="#CDD6F4" Width="120" VerticalAlignment="Center"/>
                    <CheckBox x:Name="ChkEnableOcr" Foreground="White"/>
                </StackPanel>

                <TextBlock Text="OCR 期望文字（分號分隔多個選項，例如: PartA;PartB）" Foreground="#CDD6F4" Margin="0,0,0,4"/>
                <ui:TextBox x:Name="TxtOcrExpected" PlaceholderText="例如: TYPE-A;MODEL-X" Margin="0,0,0,16"/>

            </StackPanel>
        </ScrollViewer>

        <!-- 按鈕列 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="BtnCancel"
                    Content="取消"
                    Width="90"
                    Height="36"
                    Margin="0,0,10,0"
                    Click="BtnCancel_Click"
                    Background="#313244"
                    Foreground="White"
                    BorderThickness="0"/>
            <Button x:Name="BtnSave"
                    Content="儲存"
                    Width="90"
                    Height="36"
                    Click="BtnSave_Click"
                    Background="#CBA6F7"
                    Foreground="#1E1E2E"
                    FontWeight="SemiBold"
                    BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>
