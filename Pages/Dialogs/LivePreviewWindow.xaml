<Window x:Class="LivePreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="實時預覽" Height="480" Width="640"
        WindowStyle="None" Topmost="True" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterScreen"
        Background="Black" BorderBrush="#FF00A2E8" BorderThickness="4">
    <Grid>
        <Image x:Name="PreviewImage" Stretch="Uniform" 
               RenderOptions.BitmapScalingMode="LowQuality" 
               RenderOptions.EdgeMode="Aliased" />

        <Border Background="#99000000" VerticalAlignment="Top" Padding="10">
            <TextBlock Text=" 正在進行視覺辨識，請將目標對準畫面水平垂直中心..." 
                       Foreground="Lime" FontSize="20" FontWeight="Bold"
                       HorizontalAlignment="Center" />
        </Border>

        <Path Stroke="Red" StrokeThickness="2" Opacity="0.5" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Path.Data>
                <GeometryGroup>
                    <LineGeometry StartPoint="-50,0" EndPoint="50,0" />
                    <LineGeometry StartPoint="0,-50" EndPoint="0,50" />
                </GeometryGroup>
            </Path.Data>
        </Path>

        <Border x:Name="OcrResultBorder" Background="#B3000000" VerticalAlignment="Bottom" Padding="15" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="OCR / 條碼 識別結果：" Foreground="Yellow" FontSize="16" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                <TextBlock x:Name="OcrResultText" Text="--" Foreground="Cyan" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>