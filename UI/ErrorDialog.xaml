<Window x:Class="ErrorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Width="500"
        Height="280">

    <Border
        Background="#252526"
        BorderBrush="#3C3C3C"
        BorderThickness="1"
        CornerRadius="8">

        <Grid Margin="15">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock
                Text="錯誤"
                FontSize="20"
                FontWeight="Bold"
                Foreground="#FF6B6B"/>

            <ScrollViewer Grid.Row="1"
                          Margin="0,15,0,15">

                <TextBox
    x:Name="TxtMessage"
    IsReadOnly="True"
    BorderThickness="0"
    Background="Transparent"
    Foreground="White"
    TextWrapping="Wrap"
    VerticalScrollBarVisibility="Auto"
    HorizontalScrollBarVisibility="Disabled"/>

            </ScrollViewer>

            <Button
                Grid.Row="2"
                Width="100"
                Height="32"
                HorizontalAlignment="Right"
                Content="確定"
                Click="BtnOk_Click"/>

        </Grid>

    </Border>

</Window>